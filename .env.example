APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
STAFF_USERNAME=replace-with-a-staff-username
STAFF_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
TRUSTED_HOSTS=your-service.example.com
DATA_DIR=/var/data
# Set this to the exact number of trusted HTTPS proxy hops documented by the host.
TRUSTED_PROXY_COUNT=1
COPY_LEGACY_DATA=false
# Optional: set BACKUP_DIR to a separate mounted, access-controlled backup volume.
# BACKUP_DIR=/var/backups/reunify
# Cross-age leads use a lower candidate floor only when report dates and
# reported ages form a plausible timeline. Tune on known cases before launch.
FACE_MATCH_THRESHOLD=0.52
CROSS_AGE_REVIEW_THRESHOLD=0.40
# Optional overrides when the host mounts storage elsewhere:
# DATABASE_PATH=/var/data/database.db
# UPLOAD_ROOT=/var/data/uploads
# INSIGHTFACE_HOME=/var/data/insightface
